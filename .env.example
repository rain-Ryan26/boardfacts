# Required: use an absolute writable directory outside the repository.
FLYBOARD_STORAGE_ROOT=C:\BoardFacts\data

# Optional for startup, but both are required for model-assisted analysis.
# Never commit a real endpoint credential; keep it in .env only.
# FLYBOARD_QWEN_API_BASE=https://your-compatible-endpoint.example/v1
# FLYBOARD_QWEN_API_KEY=replace-with-your-own-key
